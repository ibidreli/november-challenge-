# Copy to .env.local for local development. Never add real credentials to Git.
# Select it explicitly: uvicorn main:app --app-dir backend --env-file .env.local
DATABASE_URL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
CUSTOM_DOMAIN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback
CHALLENGE_YEAR=2026
# 10 = October rehearsal on the existing website, 11 = November challenge.
CHALLENGE_MONTH=11
COOKIE_SECURE=0
FORWARDED_ALLOW_IPS=127.0.0.1
REQUIRE_POSTGRES=0
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Set to 0 when developing without Strava imports.
ENABLE_BACKGROUND_SYNC=0
# Optional admin-authenticated diagnostics. Disabled in production by default.
ENABLE_DEBUG_ROUTES=0
