# Beispiel für lokale Entwicklung / Hinweise für Render Deploy.
# NICHT sensible Werte ins Repo committen. Auf Render: setze diese Variablen im Service Dashboard.

# Postgres (auf Render erhältst du eine DATABASE_URL wie postgres://user:pass@host:port/dbname)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# Strava OAuth
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=your_strava_secret_here
# WICHTIG: auf Render muss STRAVA_REDIRECT_URI auf deine öffentliche Render-URL zeigen:
STRAVA_REDIRECT_URI=https://your-render-service.onrender.com/auth/callback

# Sonstiges
CHALLENGE_MONTH=11
# Wenn du willst, dass der Service beim Start nicht automatisch auf sqlite zurückfällt, setze:
# REQUIRE_POSTGRES=1
