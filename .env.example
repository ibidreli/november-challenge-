# Copy to .env.local for local development. Never add real credentials to Git.
# Select it explicitly: uvicorn main:app --app-dir backend --env-file .env.local
DATABASE_URL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
CUSTOM_DOMAIN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback
CHALLENGE_YEAR=2026
# Only for a separate test database. Never enable on the production service.
CHALLENGE_TEST_MODE=0
CHALLENGE_TEST_START_DATE=
CHALLENGE_TEST_PERIOD_DAYS=
COOKIE_SECURE=0
FORWARDED_ALLOW_IPS=127.0.0.1
REQUIRE_POSTGRES=0
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Set to 0 when developing without Strava imports.
ENABLE_BACKGROUND_SYNC=0
# Pause all imports (including webhooks/manual sync) when testing with the same Strava app elsewhere.
STRAVA_SYNC_ENABLED=1
# Optional admin-authenticated diagnostics. Disabled in production by default.
ENABLE_DEBUG_ROUTES=0
