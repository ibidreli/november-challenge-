# Separate October test service: UI + API on the same Render host.
FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL="" VITE_UI_PREVIEW=false
RUN npm run build

FROM python:3.11-slim
WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./
COPY --from=frontend /frontend/dist ./frontend-dist
ENV PYTHONUNBUFFERED=1 SERVE_FRONTEND_DIRECTORY=/app/frontend-dist \
    CHALLENGE_TEST_MODE=1 CHALLENGE_TEST_START_DATE=2026-10-01 \
    REQUIRE_POSTGRES=1 LOAD_ENV_FILE=0 COOKIE_SECURE=1 ENABLE_DEBUG_ROUTES=0
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
